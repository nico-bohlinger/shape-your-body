  <contact>
    <pair geom1="left_foot" geom2="floor"/>
    <pair geom1="right_foot" geom2="floor"/>
  </contact>

  <actuator>
    <position name="left_hip_pitch" joint="left_hip_pitch_joint" forcerange="-60 60"/>
    <position name="left_hip_roll" joint="left_hip_roll_joint" forcerange="-60 60"/>
    <position name="left_hip_yaw" joint="left_hip_yaw_joint" forcerange="-17 17"/>
    <position name="left_knee_pitch" joint="left_knee_pitch_joint" forcerange="-60 60"/>
    <position name="left_foot_pitch" joint="left_foot_pitch_joint" forcerange="-17 17"/>
    <position name="right_hip_pitch" joint="right_hip_pitch_joint" forcerange="-60 60"/>
    <position name="right_hip_roll" joint="right_hip_roll_joint" forcerange="-60 60"/>
    <position name="right_hip_yaw" joint="right_hip_yaw_joint" forcerange="-17 17"/>
    <position name="right_knee_pitch" joint="right_knee_pitch_joint" forcerange="-60 60"/>
    <position name="right_foot_pitch" joint="right_foot_pitch_joint" forcerange="-17 17"/>
  </actuator>

  <sensor>
    <gyro site="imu" name="imu_angular_velocity"/>
    <velocimeter site="imu" name="imu_linear_velocity"/>
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linear_velocity"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linear_velocity"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0 0.4475 1 0 0 0
      -0.4 0 0.225 0.8 -0.4
      0.4 0 -0.225 -0.8 0.4"/>
  </keyframe>
</mujoco>
