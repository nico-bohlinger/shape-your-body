<mujoco model="opus">
  <compiler angle="radian" assetdir="assets" autolimits="true"/>

  <option cone="pyramidal" impratio="1" solver="Newton" iterations="1" ls_iterations="4" density="1.2" viscosity="0.00002">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <site size="0.01" group="5"/>
    <geom solref="-1000 -80" contype="0" conaffinity="0" group="1"/>
    <joint damping="0.01" frictionloss="0.2" armature="0.007"/>
    <position forcelimited="true" kp="20" kv="0.6"/>

    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>

    <default class="foot">
      <geom type="box" size="0.0755 0.013 0.0106" solimp="0.02 1 0.0106" priority="1" condim="6" friction="1.0 0.005 0.0001" group="4"/>
      <site/>
    </default>

    <default class="reward_collision_sphere">
      <geom group="5" rgba="1 0 0 1"/>
    </default>
  </default>

  <asset>
    <mesh name="pelvis_link_collision" file="pelvis_link_collision.stl"/>
    <mesh name="left_hip_roll_motor_link_collision" file="left_hip_roll_motor_link_collision.stl"/>
    <mesh name="left_hip_yaw_motor_link_collision" file="left_hip_yaw_motor_link_collision.stl"/>
    <mesh name="left_thigh_link_collision" file="left_thigh_link_collision.stl"/>
    <mesh name="left_calf_link_collision" file="left_calf_link_collision.stl"/>
    <mesh name="left_foot_link_collision" file="left_foot_link_collision.stl"/>
    <mesh name="right_hip_roll_motor_link_collision" file="right_hip_roll_motor_link_collision.stl"/>
    <mesh name="right_hip_yaw_motor_link_collision" file="right_hip_yaw_motor_link_collision.stl"/>
    <mesh name="right_thigh_link_collision" file="right_thigh_link_collision.stl"/>
    <mesh name="right_calf_link_collision" file="right_calf_link_collision.stl"/>
    <mesh name="right_foot_link_collision" file="right_foot_link_collision.stl"/>

    <texture type="skybox" builtin="gradient" rgb1="0.95 0.95 0.95" rgb2="0.95 0.95 0.95" width="100" height="100" />
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.345 0.575 0.748" rgb2="0.345 0.575 0.748" mark="edge" markrgb="1.0 1.0 1.0" width="512" height="512"/>
    <material name="MatPlane" texture="texplane" texrepeat="2 2" texuniform="true" specular="0.9" shininess="0.5" reflectance="0.0" rgba="1 1 1 1"/>
  </asset>

  <visual>
    <quality shadowsize="8192"/>
    <map shadowclip="0.5"/>
  </visual>

