<mujoco model="crab">
  <compiler angle="radian" assetdir="assets" autolimits="true"/>

  <option cone="pyramidal" impratio="1" solver="Newton" iterations="1" ls_iterations="4" density="1.2" viscosity="0.00002">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <site size="0.01" group="5"/>
    <geom solref="-1000 -80" contype="0" conaffinity="0" group="1"/>
    <joint damping="0.01" frictionloss="0.01" armature="0.01"/>
    <position forcelimited="true" kp="20" kv="0.5"/>

    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>

    <default class="foot">
      <geom size="0.003" solimp="0.015 1 0.003" friction="1.0 0.005 0.0001" priority="1" condim="6" group="4"/>
      <site/>
    </default>

    <default class="reward_collision_sphere">
      <geom group="5" rgba="1 0 0 1"/>
    </default>
  </default>

  <asset>
    <mesh name="thorax" file="thorax.STL"/>
    <mesh name="coxa_r" file="coxa_r.STL"/>
