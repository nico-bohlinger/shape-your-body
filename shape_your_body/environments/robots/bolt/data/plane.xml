<mujoco model="bolt">
  <compiler angle="radian" assetdir="assets" autolimits="true"/>

  <option cone="pyramidal" impratio="1" solver="Newton" iterations="1" ls_iterations="4" density="1.2" viscosity="0.00002">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <site size="0.01" group="5"/>
    <geom solref="-1000 -80" contype="0" conaffinity="0" group="1"/>
    <joint frictionloss="0.1" damping="0.01" armature="0.01"/> <!-- best guess -->
    <position forcelimited="true" kp="15" kv="0.3"/>

    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="1" rgba=".2 .2 .2 1"/>
    </default>

    <default class="foot">
      <geom type="sphere" size="0.0163" solimp="0.015 1 0.01" priority="1" condim="6" friction="1.0 0.005 0.0001" group="4"/>
      <site/>
    </default>

    <default class="reward_collision_sphere">
      <geom group="5" rgba="1 0 0 1"/>
    </default>
  </default>

  <asset>
    <mesh name="bolt_body" file="bolt_body.stl"/>
    <mesh name="bolt_hip_fe_left_side" file="bolt_hip_fe_left_side.stl"/>
    <mesh name="upper_leg_200mm_left_side" file="upper_leg_200mm_left_side.stl"/>
    <mesh name="lower_leg_200mm_left_side" file="lower_leg_200mm_left_side.stl"/>
    <mesh name="bolt_foot" file="bolt_foot.stl"/>
    <mesh name="bolt_hip_fe_right_side" file="bolt_hip_fe_right_side.stl"/>
    <mesh name="upper_leg_200mm_right_side" file="upper_leg_200mm_right_side.stl"/>
    <mesh name="lower_leg_200mm_right_side" file="lower_leg_200mm_right_side.stl"/>

    <texture type="skybox" builtin="gradient" rgb1="0.95 0.95 0.95" rgb2="0.95 0.95 0.95" width="100" height="100" />
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.345 0.575 0.748" rgb2="0.345 0.575 0.748" mark="edge" markrgb="1.0 1.0 1.0" width="512" height="512"/>
    <material name="MatPlane" texture="texplane" texrepeat="2 2" texuniform="true" specular="0.9" shininess="0.5" reflectance="0.0" rgba="1 1 1 1"/>
  </asset>

  <visual>
    <quality shadowsize="8192"/>
    <map shadowclip="0.5"/>
  </visual>

  <worldbody>
    <geom name="floor" pos="0 0 0" material="MatPlane" size="100 100 0.125" type="plane" group="0"/>
    <light name="toplight_shadow" directional="true" pos="0 0 5" dir="0.1 0.1 -1" diffuse="0.55 0.55 0.55" specular="0.12 0.12 0.12" ambient="0.04 0.04 0.04" castshadow="true"/>
    <light name="toplight_fill" directional="true" pos="0 0 5" dir="0.1 0.1 -1" diffuse="0.30 0.30 0.30" specular="0.08 0.08 0.08" ambient="0.04 0.04 0.04" castshadow="false"/>

    <body name="trunk" pos="0 0 0">
      <camera name="track" mode="trackcom" pos="0 -2 0" xyaxes="1 0 0 0 0 1"/>

      <freejoint/>

      <site name="imu" pos="0.02 0 0.04"/>

      <inertial pos="-0.000134932459328483 -0.000399086261064929 0.00195556930608449" mass="0.18520035953947" diaginertia="0.000101804322229161 0.000142404075398435 9.38193247222871e-05"/>

      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="bolt_body"/>
      <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="bolt_body"/>
      <geom class="reward_collision_sphere" pos="0.02 0 0.04" size="0.08"/>

      <camera name="ego_camera" pos="0.05 0 0.08" quat="-0.5 -0.5 0.5 0.5"/>

      <body name="FL_SHOULDER" pos="0 0.0636 0">
        <inertial pos="0.0170826 -0.00446892 -0.0109583" quat="0.380445 0.573263 0.68117 0.250275" mass="0.140043" diaginertia="0.000140999 0.000103321 5.85997e-05"/>
        <joint name="FL_HAA" pos="0 0 0" axis="-1 0 0" range="-6.28 6.28"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="bolt_hip_fe_left_side"/>
        <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="bolt_hip_fe_left_side"/>
        <body name="FL_UPPER_LEG" pos="0 0.0145 -0.0386">
          <inertial pos="1.377e-05 0.0193585 -0.118707" quat="0.705243 -0.0424536 0.0423607 0.706424" mass="0.148538" diaginertia="0.000417563 0.00041107 2.46069e-05"/>
          <joint name="FL_HFE" pos="0 0 0" axis="0 1 0" range="-6.28 6.28"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="upper_leg_200mm_left_side"/>
          <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="upper_leg_200mm_left_side"/>
          <geom class="reward_collision_sphere" pos="0.0 0.02 -0.085" size="0.03"/>
          <body name="FL_LOWER_LEG" pos="0 0.0374 -0.2">
            <inertial pos="0 0.00836601 -0.116186" quat="0.707082 -0.00588079 0.00588079 0.707082" mass="0.0312724" diaginertia="0.00011713 0.000116139 2.69836e-06"/>
            <joint name="FL_KFE" pos="0 0 0" axis="0 1 0" range="-6.28 6.28"/>
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="lower_leg_200mm_left_side"/>
            <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="lower_leg_200mm_left_side"/>
            <geom pos="0 0.008 -0.21" quat="0.385543 0 0.92269 0" type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="bolt_foot"/>
            <geom pos="0 0.008 -0.21" quat="0.385543 0 0.92269 0" type="mesh" rgba="0.1 0.1 0.1 1" mesh="bolt_foot"/>
            <geom name="left_foot" pos="0 0.008 -0.21" class="foot"/>
            <site name="left_foot" pos="0 0.008 -0.21" class="foot"/>
            <geom class="reward_collision_sphere" pos="0.0 -0.008 0" size="0.03"/>
            <geom class="reward_collision_sphere" pos="0.0 0.008 -0.11" size="0.012"/>
            <geom class="reward_collision_sphere" pos="0.0 0.008 -0.21" size="0.0163"/>
          </body>
        </body>
      </body>
      <body name="FR_SHOULDER" pos="0 -0.0636 0">
        <inertial pos="0.0170823 0.00447099 -0.0109585" quat="0.250376 0.681095 0.573344 0.380393" mass="0.140044" diaginertia="0.000141003 0.000103316 5.8591e-05"/>
        <joint name="FR_HAA" pos="0 0 0" axis="-1 0 0" range="-6.28 6.28"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="bolt_hip_fe_right_side"/>
        <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="bolt_hip_fe_right_side"/>
        <body name="FR_UPPER_LEG" pos="0 -0.0145 -0.0386">
          <inertial pos="-1.377e-05 -0.0193585 -0.118707" quat="0.705243 0.0424536 -0.0423607 0.706424" mass="0.148538" diaginertia="0.000417563 0.00041107 2.46069e-05"/>
          <joint name="FR_HFE" pos="0 0 0" axis="0 -1 0" range="-6.28 6.28"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="upper_leg_200mm_right_side"/>
          <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="upper_leg_200mm_right_side"/>
          <geom class="reward_collision_sphere" pos="0.0 -0.02 -0.085" size="0.03"/>
          <body name="FR_LOWER_LEG" pos="0 -0.0374 -0.2">
            <inertial pos="0 -0.00836601 -0.116186" quat="0.707082 0.00588079 -0.00588079 0.707082" mass="0.0312724" diaginertia="0.00011713 0.000116139 2.69836e-06"/>
            <joint name="FR_KFE" pos="0 0 0" axis="0 -1 0" range="-6.28 6.28"/>
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="lower_leg_200mm_right_side"/>
            <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="lower_leg_200mm_right_side"/>
            <geom pos="0 -0.008 -0.21" quat="0.385543 0 0.92269 0" type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.1 0.1 0.1 1" mesh="bolt_foot"/>
            <geom pos="0 -0.008 -0.21" quat="0.385543 0 0.92269 0" type="mesh" rgba="0.1 0.1 0.1 1" mesh="bolt_foot"/>
            <geom name="right_foot" pos="0 -0.008 -0.21" class="foot"/>
            <site name="right_foot" pos="0 -0.008 -0.21" class="foot"/>
            <geom class="reward_collision_sphere" pos="0.0 0.008 0" size="0.03"/>
            <geom class="reward_collision_sphere" pos="0.0 -0.008 -0.11" size="0.012"/>
            <geom class="reward_collision_sphere" pos="0.0 -0.008 -0.21" size="0.0163"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <pair geom1="left_foot" geom2="floor"/>
    <pair geom1="right_foot" geom2="floor"/>
  </contact>

  <actuator>
    <position name="FL_HAA" joint="FL_HAA" forcerange="-18 18"/>
    <position name="FL_HFE" joint="FL_HFE" forcerange="-18 18"/>
    <position name="FL_KFE" joint="FL_KFE" forcerange="-18 18"/>
    <position name="FR_HAA" joint="FR_HAA" forcerange="-18 18"/>
    <position name="FR_HFE" joint="FR_HFE" forcerange="-18 18"/>
    <position name="FR_KFE" joint="FR_KFE" forcerange="-18 18"/>
  </actuator>

  <sensor>
    <gyro site="imu" name="imu_angular_velocity"/>
    <velocimeter site="imu" name="imu_linear_velocity"/>
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linear_velocity"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linear_velocity"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0 0.43255 1 0 0 0
      0.0 -0.4 0.8
      0.0 0.4 -0.8"/>
  </keyframe>
</mujoco>
